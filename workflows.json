b29-4902-ab5c-87c31e836d68","name":"If1"},{"parameters":{"amount":15},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[896,-16],"id":"89643aa5-77be-4437-8650-f74a2ba13877","name":"Wait1","webhookId":"acbf6a3a-347c-4617-b699-40358ec39740"},{"parameters":{"jsCode":"// 1. Read or initialize the persistent counter in global static data\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.counter === undefined) {\n  staticData.counter = 0;\n}\n\n// 2. Read all incoming items\nconst items = $input.all();\n\n// 3. Iterate over each item, bump counter, wrap 1–4, and compute scheduledTime\nconst results = items.map(item => {\n  // Increment and wrap back to 1 after 4\n  staticData.counter += 1;\n  if (staticData.counter > 4) {\n    staticData.counter = 1;\n  }\n\n  // Parse finished_at or use current date\n  const raw = item.json.finished_at;\n  const baseDate = raw ? new Date(raw) : new Date();\n  if (isNaN(baseDate.getTime())) {\n    throw new Error(`Invalid date \"${raw}\" on item`);\n  }\n\n  // Add days based on the counter (1–4)\n  baseDate.setDate(baseDate.getDate() + staticData.counter);\n\n  return {\n    json: {\n      scheduledTime: baseDate.toISOString(),\n      counter: staticData.counter,\n    },\n  };\n});\n\n// 4. Return array of { json: { … } } items\nreturn results;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-48,256],"id":"e16c9adf-9b07-4aa5-a558-ee2812c7fda6","name":"Code"},{"parameters":{"url":"={{ $('Get High Resolution Short').item.json.src_url }}","options":{"response":{"response":{"responseFormat":"file"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[96,256],"id":"e86d630d-7ace-464f-919b-54ce37367854","name":"Make the Video Downloadable"},{"parameters":{"content":"## Steps for creating different vidoes \n**Double click** to edit me. [Guide](https://docs.n8n.io/workflows/sticky-notes/)\n\n- In postman change the POST link \nhttp://localhost:5678/webhook-test/generate-shorts\n{\n  \"vid